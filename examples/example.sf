// Example struct-frame file demonstrating syntax

package sensor_data;

option pkgid = 1;

/* Enum for sensor status */
enum SensorStatus {
  OFFLINE = 0;
  ONLINE = 1;
  ERROR = 2;
}

message SensorReading {
  option msgid = 1;
  option variable = true;
  option magic_bytes = "0xA3, 0x7F";

  SensorStatus status = 1 [default = ONLINE];
  float value = 2 [default = 0.0];
  string name = 3 [size=16, default = "unknown"];
  repeated uint8 data = 4 [max_size=200];
  uint32 timestamp = 5;
}

message Container {
  option msgid = 2;
  option variable = true;
  SensorReading reading = 1;

  oneof payload {
    option variable = true;
    SensorReading sensor = 2;
    SensorReading other = 3;
  }
}
